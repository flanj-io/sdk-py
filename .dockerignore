# The integration harness passes this directory as a NAMED BuildKit context and the
# Dockerfile does `COPY --from=sdk-py . .`, so everything here is transferred and
# then baked into the image. Without this file that includes the local virtualenv
# and every built artefact — tens of megabytes of transfer on every lane, for files
# `pip install .` does not read.
.venv/
venv/
dist/
build/
*.egg-info/
.git/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.claude/
htmlcov/
.coverage
